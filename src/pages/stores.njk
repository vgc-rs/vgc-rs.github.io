---
layout: base.njk
title: Lojas
permalink: /lojas/
---
{% import "macros.njk" as m with context %}
<h1 class="page-title">Lojas</h1>

<section class="event-text">
  <p>Estas são as lojas parceiras do VGC-RS. Os torneios costumam acontecer uma vez por mês em cada uma.</p>
</section>

<div class="stores">
  {% for s in stores %}{% if s.active %}
    <section class="store" id="{{ s.id }}">
      <div class="store-header">
        <h2>{{ s.name }}</h2>
        <p class="event-meta">{% if s.address %}{{ s.address }}{% if s.city %}, {{ s.city }}{% endif %}{% else %}Endereço a confirmar{% endif %}</p>
        <div class="actions">
          {% if s.address %}<a class="button" href="https://www.google.com/maps/search/?api=1&query={{ (s.address + ', ' + (s.city or '') + ', RS') | urlencode }}" target="_blank" rel="noopener">Abrir no Mapa</a>{% endif %}
          {% if s.instagram %}<a class="button button-secondary" href="https://instagram.com/{{ s.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
        </div>
        {% if s.photo %}<img class="store-photo" src="{{ s.photo }}" width="960" height="720" alt="Fachada da {{ s.name }}" loading="lazy" />{% endif %}
      </div>
      <div class="store-side">
        {% if s.organizer %}
          <div class="organizer">
            <span class="player-photo">{{ m.playerPhoto(s.organizer) }}</span>
            <div class="organizer-info">
              <span class="organizer-role">Organizador</span>
              <strong class="organizer-name">{{ s.organizer.name }}</strong>
            </div>
          </div>
        {% endif %}
        {% if s.address %}
          <iframe class="map" title="Mapa da {{ s.name }}" loading="lazy" src="https://www.google.com/maps?q={{ (s.address + ', ' + (s.city or '') + ', RS') | urlencode }}&output=embed"></iframe>
        {% endif %}
      </div>
    </section>
  {% endif %}{% endfor %}
</div>
